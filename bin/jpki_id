#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

(
  {

    # pin
#   pin_card=''
#   pin_auth=''
#   pin_sign=''

    dat_dir="${HOME}/dat"
    cer_dir="${dat_dir}/net.wan/jp.go.jpki.www/ca/pdf"
    tmp_dir="$(mktemp -d)"

    # wait
    while true; do

      check="$(myna check | grep -v ': OK')"

      if echo "${check}" | grep 'No PC/SC readers found.'; then
        false
      fi
      if echo "${check}" | grep ': NG'; then
#       false
        sleep 1
        continue
      fi

      break

    done

    # verify
    function _verify() {
      find "${tmp_dir}" -type f -name '*.der' | while read i; do

        prefix="$(echo "${i}" | sed -e 's#.*/##g' -e 's/\..*//g')"

        while read j; do
          openssl verify -CAfile "${j}" "${i}" &> '/dev/null' && is_ok=
        done < <(find "${cer_dir}" -type f -name "${prefix}ca*.cer" | sort)

        if [[ ! -v is_ok ]]; then
          echo '⚠️カード不正'
          false
        fi

      done
    }

    # reset
    myna pin status
    test -v pin_card && myna pin change card --pin "${pin_card}" --newpin "${pin_card}"
    test -v pin_auth && myna pin change auth --pin "${pin_auth}" --newpin "${pin_auth}"
    test -v pin_sign && myna pin change sign --pin "${pin_sign}" --newpin "${pin_sign}"

    # jpki
#   true             && myna jpki cert --type 'auth-ca' --format 'der'                                 >  "${tmp_dir}/authca.der"
#   true             && myna jpki cert --type 'sign-ca' --format 'der'                                 >  "${tmp_dir}/signca.der"
    true             && myna jpki cert --type 'auth'    --format 'der'                                 >  "${tmp_dir}/auth.der"
    test -v pin_sign && myna jpki cert --type 'sign'    --format 'der' --password "${pin_sign}"        >  "${tmp_dir}/sign.der"

    _verify

    # 個人番号
#   test -v pin_card && mynumber="$(myna text mynumber --pin "${pin_card}" | awk '{print "個人番号: " substr($0,1,4) "-" substr($0,5,4) "-" substr($0,9,4)}')"

    # 券面事項入力補助AP
    true             && myna text basic-info                                                           >  "${tmp_dir}/text.txt"
    test -v mynumber && echo "${mynumber}"                                                             >> "${tmp_dir}/text.txt"
    test -v pin_card && myna text attrs   --pin "${pin_card}"                                          >> "${tmp_dir}/text.txt"

    # 券面事項確認AP
    true             && myna visual basic-info                                                         >  "${tmp_dir}/photo.txt"
    test -v pin_card && myna visual photo --pin "${pin_card}" --output '/dev/stdout' | convert - png:- >  "${tmp_dir}/photo.png"

    # 謎AP
    true             && myna unknown number                                                            >  "${tmp_dir}/unknown.txt"
    true             && myna unknown manufacture                                                       >> "${tmp_dir}/unknown.txt"

    # cms
#   test -v pin_sign && myna jpki cms sign   --password "${pin_sign}" --help
#   test -v pin_sign && myna jpki cms verify                          --help

    check="$(  openssl x509 -inform der -in "${tmp_dir}/auth.der" -noout -text)"
    serial="$( openssl x509 -inform der -in "${tmp_dir}/auth.der" -noout -serial  | sed    's/serial=//g')"
    subject="$(openssl x509 -inform der -in "${tmp_dir}/auth.der" -noout -subject | sed -r 's/.*CN=([0-9A-Z]+).*/\1/g')"
    enddate="$(openssl x509 -inform der -in "${tmp_dir}/auth.der" -noout -enddate | cut -d= -f2)"
    pubkey="$( openssl x509 -inform der -in "${tmp_dir}/auth.der" -noout -pubkey)"
    dirname="$(openssl x509 -inform der -in "${tmp_dir}/auth.der" -noout -ext crlDistributionPoints | grep "DirName:" | sed -e 's/.*DirName://g')"

    jpki_id="$( echo -n "${serial}_${subject}" | vhash)"
    birthday="$(date -u -d "${enddate}" "+%m%d")"

    echo "${pubkey}" | ssh-keygen -f '/dev/stdin' -i -m pkcs8 > "${tmp_dir}/auth.ssh.pub"
    echo "${dirname}" | sed 's/, /\n/g'

#   exp_dir="${dat_dir}/uid.個人番号/${mynumber}"
#   exp_dir="${dat_dir}/uid.個人番号/$(echo -n "${mynumber}" | vhash)"
    exp_dir="${dat_dir}/uid.jpki_id/${jpki_id}"
    mkdir -p "${exp_dir}"
    mv "${tmp_dir}/"* "${exp_dir}"

  } >&2
  echo "${jpki_id}"
)
