#!/usr/bin/env python3

import os
import re
import git
import hashlib
import magic
import subprocess

from pathlib import Path

home    = os.environ.get("HOME")

doc_dir = home + "/doc"

def mkdoc() -> None:

  repo = git.Repo(home, search_parent_directories=True)
  for path in repo.git.ls_files().split("\n"):

    src_name      = re.sub('.*/', '', path)
    src_name_hash = hashlib.sha256(src_name.encode()).hexdigest()

    src_file = os.path.join(repo.working_tree_dir, path)
    dst_file = os.path.join(doc_dir, "man",        path, "..", src_name_hash + ".txt")
    dst_file = os.path.normpath(dst_file)
    if not os.path.isfile(src_file):
      continue
    if os.path.isfile(dst_file):
      continue
    if not is_text(src_file):
      continue

    prompt_sys   = f"<path>{path}</path>"
    prompt_sys  +=  "<task>ファイルの内容を解説します。</task>"
    prompt_sys  +=  "<format>Markdown(見出しは##以降を使用する)</format>"
    prompt_user  = fread(src_file)

    result  = chat(prompt_sys, prompt_user)
    content = f"""# {src_name}

<WRAP round important>このドキュメントはAIにより生成されました。</WRAP>

{result}
"""

    os.makedirs(os.path.normpath(dst_file + '/..'), exist_ok=True)

    fwrite(dst_file, content)
    Path(home + '/src/0.doc/conf/local.php').touch()
    print(src_file)

def chat(prompt_sys, prompt_user) -> str:

  process = subprocess.run(
    ["chat", prompt_sys, prompt_user],
    text=True,
    capture_output=True,
    encoding="utf-8",
    check=True
  )

  return process.stdout.strip()

def is_text(file) -> bool:

  mime_type = magic.from_file(file, mime=True)

  ret  = False
  ret |= mime_type.startswith("text/")
  ret |= mime_type.startswith("application/json")

  return ret

def fread(file, encoding="utf8") -> str:

  content = None

  with open(file, "r", encoding=encoding) as f:
    content = f.read()

  return content

def fwrite(file, content) -> None:

  with open(file, "w") as f:
    f.write(content)

def main():
  mkdoc()

if __name__ == "__main__":
  main()
