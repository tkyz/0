#!/usr/bin/env python3

from py0 import py0

import sys
import magic

from git import Repo

dic_dir = py0.doc_dir + "/chat"

def copilot() -> None:

  messages = []
# messages.append({"role": "system", "content": None})

  repo = Repo(".")
  for blob in repo.head.commit.tree.traverse():

    if "blob" != blob.type:
      continue

    path    = blob.path
    data    = blob.data_stream.read()
    mime    = magic.from_buffer(data, mime=True)
    content = None

    is_text  = False
    is_text |= mime.startswith("text/")
    is_text |= mime.startswith("application/json")
    if is_text:
      content = data.decode("utf8")

    messages.append({"role": path, "content": content})

  while True:

    line = sys.stdin.readline()
    if "\n" == line:
      break

    messages.append({"role": "user",      "content": line})
    messages.append({"role": "assistant", "content": py0.assistant(messages)})

def main() -> None:
  try:
    copilot()
  except KeyboardInterrupt:
    pass

if __name__ == "__main__":
  main()
