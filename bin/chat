#!/usr/bin/env python3

from py0 import py0

import sys
import magic

from git import Repo

def copilot() -> None:

  messages = []
# messages.append({"role": "system", "content": None})

  repo = Repo(".", search_parent_directories=True)
  for blob in repo.head.commit.tree.traverse():

    if "blob" != blob.type:
      continue

    path      = blob.path
    full_path = repo.working_dir + "/" + path
    content   = None

    if os.path.isfile(full_path):
      mime = magic.from_file(full_path, mime=True)
      if is_text(mime):
        content = py0.fread(full_path)
    else:
      data = blob.data_stream.read()
      mime = magic.from_buffer(data, mime=True)
      if is_text(mime):
        try:
          content = data.decode("utf8")
        except UnicodeDecodeError:
          pass

    messages.append({"role": path, "content": content})

  while True:

    line = sys.stdin.readline()
    if "\n" == line:
      break

    messages.append({"role": "user",      "content": line})
    messages.append({"role": "assistant", "content": py0.assistant(messages)})

def is_text(mime_type) -> bool:

  is_text  = False
  is_text |= mime_type.startswith("text/")
  is_text |= mime_type.startswith("application/json")

  return is_text

def main() -> None:
  try:
    copilot()
  except KeyboardInterrupt:
    pass

if __name__ == "__main__":
  main()
