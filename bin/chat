#!/usr/bin/env python3

from py0 import py0

import os
import sys
import git
import json
import magic
import socket
import urllib.request
import ssl

def main() -> None:

  args        = sys.argv[1:]
  prompt_user = args[0] if 0 < len(args) else ""

  messages = []

  # system
  messages.append({"role": "system", "content": """
role:
  system:     このプロンプト
  entrypoint: {このファイルのパス}
  command[]:  {コマンド} + "\n" + {コマンドの結果}
  code[]:     {ファイルのパス} + "\n" + {ファイルの内容}
"""})

  # entrypoint
  content = os.path.abspath(__file__)
  messages.append({"role": "entrypoint", "content": f"{content}"})

  # command
  commands = [
#   ["date"],
#   ["lshw"],
#   ["lscpu"],
    ["lspci"],
    ["lsusb"],
#   ["lsblk"],
#   ["nvidia-smi"],
#   ["bash", '-c', 'export'],
  ]
  for command in commands:
    c      = " ".join(command)
    result = py0.call(*command)
    messages.append({"role": "command", "content": f"{c}\n{result}"})

  # code
  for f in files():
    content = py0.fread(f)
    messages.append({"role": "code", "content": f"{f}\n{content}"})

  messages.append({"role": "user", "content": prompt_user})

  api(messages)

def api(messages) -> None:

  payload = {
    "model": "default",
    "stream": True,
    "messages": messages,
    "chat_template_kwargs": {"enable_thinking": False},
  }

  url = f"https://chat.{py0.domain}/v1/chat/completions"
  req = urllib.request.Request(
    url,
    data    = json.dumps(payload).encode("utf-8"),
    headers = {"Content-Type": "application/json"},
    method  = "POST",
  )

  with urllib.request.urlopen(req, context=ssl_context()) as resp:
    for raw in resp:

      line = raw.decode("utf-8").strip()
      if not line.startswith("data:"):
        continue

      data = line[len("data:"):].strip()
      if data == "[DONE]":
        break

      chunk   = json.loads(data)
      choices = chunk.get("choices", [])

      for choice in choices:

        delta = choice.get("delta", {})

        # reasoning
        data = delta.get("reasoning_content") or delta.get("reasoning")
        if data:
          sys.stdout.write(data)
          sys.stdout.flush()

        # content
        data = delta.get("content")
        if data:
          sys.stdout.write(data)
          sys.stdout.flush()

  sys.stdout.write("\n")
  sys.stdout.flush()

def files() -> list:

  l = set()

  # ./.git
  if True:
    repo = git.Repo(py0.home, search_parent_directories=True)
    for path in repo.git.ls_files().split("\n"):
      full_path = os.path.join(repo.working_tree_dir, path)
      if not os.path.isfile(full_path):
        continue
      if not is_text(full_path):
        continue
      l.add(full_path)

  # ./doc
  if False:
    for root, dirs, files_ in os.walk(py0.doc_dir):
      for f in files_:
        full_path = root + "/" + f
        if not is_text(full_path):
          continue
        l.add(full_path)

  # ./.env
  l.add(py0.home + "/.env")

  return sorted(list(l))

def ssl_context() -> ssl.SSLContext:
  ctx = ssl.create_default_context()
  ctx.check_hostname = False
  ctx.verify_mode    = ssl.CERT_NONE
  return ctx

def is_text(file) -> bool:

  mime_type = magic.from_file(file, mime=True)

  ret  = False
  ret |= mime_type.startswith("text/")
  ret |= mime_type.startswith("application/json")

  return ret

if __name__ == "__main__":
  main()
