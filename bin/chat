#!/usr/bin/env python3

from py0 import py0

import os
import sys
import re
import git
import json
import magic
import urllib.request
import ssl

from pathlib import Path

def chat() -> None:

  messages = []

  if True:

    messages.append({"role": "system", "content": r"""
system: このプロンプト
  system[]: {コマンド}      + "\n" + {コマンドの実行結果}
  system[]: {ファイルのパス} + "\n" + {ファイルの内容}
"""})

    commands = [
      # time
#     ["date"],
      # hardware
#     ["lshw"],
#     ["lscpu"],
      ["lspci"],
      ["lsusb"],
#     ["lsblk"],
#     ["nvidia-smi"],
      # software
#     ["dpkg", "--list"],
      ["pip",  "list"],
      # 環境変数
#     ["bash", "-c", "export"],
    ]
    for command in commands:
      messages.append({"role": "system", "content": " ".join(command) + "\n" + py0.call(*command)})

    # file
    for f in files():
      if not os.path.isfile(f):
        continue
      mime_type = magic.from_file(f, mime=True)
      if not is_prompt(mime_type):
        continue
      messages.append({"role": "system", "content": f"{f}\n" + py0.fread(f)})

  print("chat...")
  while True:
    messages.append({"role": "user",      "content": sys.stdin.readline()})
    print()
    messages.append({"role": "assistant", "content": assistant(messages)})
    print()

def assistant(messages, thinking=False) -> str:

  content = []

  payload = {
    "model": "default",
    "stream": True,
    "messages": messages,
    "chat_template_kwargs": {"enable_thinking": thinking},
  }

  url = f"https://chat.{py0.domain}/v1/chat/completions"
  req = urllib.request.Request(
    url,
    data    = json.dumps(payload).encode("utf-8"),
    headers = {"Content-Type": "application/json"},
    method  = "POST",
  )

  with urllib.request.urlopen(req, context=ssl_context()) as resp:
    for raw in resp:

      line = raw.decode("utf-8").strip()
      if not line.startswith("data:"):
        continue

      data = line[len("data:"):].strip()
      if data == "[DONE]":
        break

      chunk   = json.loads(data)
      choices = chunk.get("choices", [])

      for choice in choices:

        delta = choice.get("delta", {})

        # reasoning
        data = delta.get("reasoning_content") or delta.get("reasoning")
        if data:
          sys.stdout.write(data)
          sys.stdout.flush()
#         content.append(data)

        # content
        data = delta.get("content")
        if data:
          sys.stdout.write(data)
          sys.stdout.flush()
          content.append(data)

  sys.stdout.write("\n")
  sys.stdout.flush()

  return "".join(content)

def files() -> list:

  l = list()

  # .git
  repo = git.Repo(py0.home, search_parent_directories=True)
  for path in repo.git.ls_files().split("\n"):
    l.append(os.path.join(repo.working_tree_dir, path))

  # document
  for root, dirs, files_ in os.walk(py0.doc_dir):
    for f in files_:
      l.append(root + "/" + f)

  # .env
  l.append(py0.env_file)

  return sorted(set(l))

def ssl_context() -> ssl.SSLContext:
  ctx = ssl.create_default_context()
# ctx.load_verify_locations("/usr/local/share/ca-certificates/" + py0.namespace + ".crt") # TODO: CERTIFICATE_VERIFY_FAILED
  ctx.check_hostname = False
  ctx.verify_mode    = ssl.CERT_NONE
  return ctx

def is_prompt(mime_type) -> bool:

  ret  = False
  ret |= mime_type.startswith("application/json")
  ret |= mime_type.startswith("inode/x-empty")
  ret |= mime_type.startswith("text/")

  return ret

def main() -> None:
  try:
    chat()
  except KeyboardInterrupt:
    pass

if __name__ == "__main__":
  main()
