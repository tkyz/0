#!/usr/bin/env python3

import sys
import hashlib

# scope
def block0() -> bytes:
  return b"public"

def main() -> None:

  hasher = hashlib.sha256()

  blk0  = block0()
  hash0 = hashlib.sha256(blk0).hexdigest()

  hasher.update((hash0 + "\n").encode())
  if not sys.stdin.isatty():
    while chunk := sys.stdin.buffer.read(4 * 1024):
      hasher.update(chunk)
  hash1 = hasher.hexdigest()

  print(hash1)

if __name__ == "__main__":
  main()
