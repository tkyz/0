#!/usr/bin/env python3

from py0 import py0

import os
import re

counter = {}
def walk() -> None:

  dirs = list()
  for d in os.listdir(py0.text_dir + "/.."):

    full_path = os.path.normpath(py0.text_dir + "/../" + d)

    if not full_path.startswith(py0.text_dir):
      continue

    dirs.append(full_path)

  while 0 < len(dirs):

    d = dirs.pop()
    for i in os.listdir(d):

      full_path = d + "/" + i

      if os.path.isdir(full_path):
        dirs.append(full_path)
        continue

      content_bef = py0.fread(full_path)
      content_aft = content_bef
      content_aft = _trim(content_aft)
      content_aft = _half(content_aft)
      content_aft = _replace(content_aft)

      if content_bef != content_aft:
        py0.fwrite(full_path, content_aft)
        print(full_path)

# for i in sorted(counter.items(), key=lambda x: x[1], reverse=False):
#   print(i)

def _trim(content) -> str:

  content = content.replace("\r\n", "\n").replace("\r", "\n")
  content = re.sub(r"^[ 　\t]+",  r"",       content, flags=re.M)
  content = re.sub(r"[ 　\t]+$",  r"",       content, flags=re.M)
  content = re.sub(r"[ 　\t]{2,}", r" ",      content)
  content = re.sub(r"[\n]{4,}",    r"\n\n\n", content)
  content = re.sub(r"[\n]{2,}$",   r"\n",     content)

  return content

def _half(content) -> str:
  return content.translate(str.maketrans({
    chr(c + 0xFEE0): chr(c)
    for c in (
      *range(ord("0"), ord("9") + 1),
      *range(ord("A"), ord("Z") + 1),
      *range(ord("a"), ord("z") + 1),
    )
  }))

def _replace(content) -> str:

  mask         = "[⚪︎⚪️◯○●◎〇]"
  replacements = {
#   "a" + mask + "c": "abc",
  }

  for key, val in replacements.items():
    content = re.sub(key, val, content)

  for w in re.compile(".{,3}" + mask + ".{,3}").findall(content):
    counter[w] = counter.get(w, 0) + 1

  return content

def main() -> None:
  walk()

if __name__ == "__main__":
  main()
