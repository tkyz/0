#!/usr/bin/env python3

from py0 import py0

import os
import sys
import hashlib
import re
import magic
import duckdb

from pathlib import Path

def mkindex(target_dir) -> None:

  dirs = list()
  dirs.append(str(Path(target_dir).absolute()))

  os.makedirs(py0.index_dir, exist_ok=True)

  if True:
    while 0 < len(dirs):

      d = dirs.pop()
      if not os.path.exists(d):
        continue

      dir_hash    = hashlib.sha256(d.encode()).hexdigest()
      idx_file    = py0.index_dir + "/" + dir_hash
      idx_entries = tsv_select(idx_file)

      files = list()
      try:

        for i in os.listdir(d):

          full_path = d + '/' + i
          if is_skip(full_path):
            continue
          if os.path.islink(full_path):
            continue

          if os.path.isdir(full_path):
            dirs.append(full_path)
          elif os.path.isfile(full_path):
            files.append(full_path)

      except PermissionError as e:
        pass

      if 0 == len(files):
        if os.path.isfile(idx_file):
          os.remove(idx_file)
        continue

      for f in files:

        full_path = f
        if not os.path.exists(full_path):
          continue

        idx_entry              = idx_entries.get(full_path) or dict()
        idx_entry["path"]      = full_path
        idx_entry["exist"]     = True
        idx_entries[full_path] = idx_entry

        file_stat = os.stat(full_path)
        file_size = file_stat.st_size
        file_date = int(max(file_stat.st_atime, file_stat.st_mtime, file_stat.st_ctime))

        if idx_entry.get("size") != file_size or idx_entry.get("date") != file_date:
          idx_entry["size"]      = file_size
          idx_entry["date"]      = file_date
          idx_entry["mime_type"] = None
          idx_entry["hash"]      = None

        if idx_entry.get("mime_type") is None:
          idx_entry["mime_type"] = magic.from_file(full_path, mime=True)

        if idx_entry.get("hash") is None:
          if file_size < 1024 * 1024 or is_hash(idx_entry.get("mime_type")):
            h = hashlib.sha256()
            with open(full_path, "rb") as f_:
              for chunk in iter(lambda: f_.read(65536), b""):
                h.update(chunk)
            idx_entry["hash"] = h.hexdigest()

      with open(idx_file, "w", buffering=1024*1024) as f:
        for e in idx_entries.values():

          if not e.get("exist"):
            continue

          c1 = e.get("hash")
          c2 = e.get("size")
          c3 = e.get("date")
          c4 = e.get("mime_type")
          c5 = e.get("path")

          line  = ""   + (c1 or "")
          line += "\t" + str(c2)
          line += "\t" + str(c3)
          line += "\t" + (c4 or "")
          line += "\t" + c5
          print(line)

          f.write(line + "\n")

def tsv_select(idx_file) -> dict:

  entries = None

  if os.path.exists(idx_file):
    with duckdb.connect(":memory:") as con:
      rel     = con.execute(f"SELECT * FROM read_csv('{idx_file}', delim='\t', header=False, names=['hash', 'size', 'date', 'mime_type', 'path'])")
      columns = [desc[0] for desc in rel.description]
      entries = {row[-1]: dict(zip(columns, row)) for row in rel.fetchall()}

  return entries or dict()

def is_skip(path) -> bool:

  prefixs = [
    py0.index_dir,                # ${HOME}/dat/index*
    py0.dat_dir + "/net.wan",     # ${HOME}/dat/net.wan*
    py0.dat_dir + "/train",       # ${HOME}/dat/train*
    py0.enc_dir,                  # ${HOME}/enc
    py0.home + "/go/",            # ${HOME}/go
    py0.lib_dir,                  # ${HOME}/lib
#   py0.mnt_dir,                  # ${HOME}/mnt
    py0.opt_dir,                  # ${HOME}/opt
    py0.src_dir + "/com.github/", # ${HOME}/src/com.github
  ]

  skip  = False
  skip |= bool(re.search(r"/\.", path)) # .*
  for i in prefixs:
    skip |= path.startswith(i)
    if skip:
      break

  return skip

def is_hash(mime_type) -> bool:

  prefixs = [
    "application/javascript",
    "application/json",
    "application/pdf",
    "application/pgp-encrypted",
    "application/pgp-keys",
    "application/msword",
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "application/x-bittorrent",
    "application/xhtml+xml",
#   "audio/",
    "font/",
#   "image/",
    "inode/",
    "text/",
#   "video/",
  ]

  is_hash = False
  for i in prefixs:
    is_hash |= mime_type.startswith(i)
    if is_hash:
      break

  return is_hash

def main() -> None:

  arg1 = sys.argv[1] if 1 < len(sys.argv) else py0.pwd

  mkindex(arg1)

if __name__ == "__main__":
  main()
