#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

(

  wan_ip=

  test -z "${wan_ip}" && wan_ip="$(dig +short        'myip.opendns.com'        '@resolver1.opendns.com')"
  test -z "${wan_ip}" && wan_ip="$(dig +short        'myip.opendns.com'        '@resolver2.opendns.com')"
  test -z "${wan_ip}" && wan_ip="$(dig +short        'myip.opendns.com'        '@resolver3.opendns.com')"
  test -z "${wan_ip}" && wan_ip="$(dig +short        'myip.opendns.com'        '@resolver4.opendns.com')"
  test -z "${wan_ip}" && wan_ip="$(dig +short txt ch 'whoami.cloudflare'       '@1.1.1.1'        | tr -d '"')"
  test -z "${wan_ip}" && wan_ip="$(dig +short txt    'o-o.myaddr.l.google.com' '@ns1.google.com' | tr -d '"')"

  echo "${wan_ip}"

)
