#!/usr/bin/env python3

import os
import sys
import uuid
import torch

from diffusers import (
  WanPipeline,
  AutoencoderKLWan,
)
from diffusers.utils import export_to_video

home = os.environ.get('HOME')

def main():

  model_path = home + '/lib/co.huggingface/Wan-AI/Wan2.2-T2V-A14B-Diffusers'

# size_w = 480; size_h = 640
  size_w = 640; size_h = 480

  batch          =  1
  num_frames     = 81
  guidance_scale =  5.0
  fps            = 15

  prompt_p = sys.argv[1] if 1 < len(sys.argv) else ''
  prompt_n = sys.argv[2] if 2 < len(sys.argv) else ''
  prompt_p = [prompt_p] * batch
  prompt_n = [prompt_n] * batch

  vae  = AutoencoderKLWan.from_pretrained(model_path, local_files_only=True, dtype=torch.float32,  subfolder='vae')
  pipe = WanPipeline.from_pretrained(     model_path, local_files_only=True, dtype=torch.bfloat16, vae=vae)
  pipe.to('cuda')

  frames = pipe(prompt=prompt_p, negative_prompt=prompt_n, width=size_w, height=size_h, num_frames=num_frames, guidance_scale=guidance_scale).frames

  for frame in frames:
    export_to_video(frame, './' + str(uuid.uuid4()) + '.mp4', fps=fps)

if __name__ == '__main__':
  main()
